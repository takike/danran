{
  "name": "danran",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:staging": "CLOUDFLARE_ENV=staging vite build",
    "build:production": "CLOUDFLARE_ENV=production vite build",
    "preview": "vite preview",
    "pwa:icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --env staging --remote",
    "db:migrate:production": "wrangler d1 migrations apply DB --env production --remote"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@holiday-jp/holiday_jp": "^2.5.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.7.2",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@cloudflare/vite-plugin": "^1.61.0",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "^5.20260928.1",
    "@playwright/test": "^1.51.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/runner": "~4.1.0",
    "@vitest/snapshot": "~4.1.0",
    "drizzle-kit": "^0.31.11",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "~4.1.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.142.0"
  }
}
