# Danran Local Environment Variables Example (.dev.vars.example)
#
# Create .dev.vars ONLY if absent (do NOT overwrite an existing .dev.vars file with cp).
# If .dev.vars already exists, inspect and add any missing variables manually.
#
# NOTE: .dev.vars is NOT needed for local D1 database, health check (/api/health),
# or running unit/worker integration tests.
# Never commit real secrets, private keys, or production credentials.

# Local application origin (used for OAuth redirect URLs and same-origin configuration)
# OAuth callback URL is always built from APP_ORIGIN: ${APP_ORIGIN}/api/auth/callback
# APP_ORIGIN per environment:
# - local:      http://localhost:5173
# - staging:    https://danran-staging.tak-ikemachi.workers.dev
# - production: https://danran.tak-ikemachi.workers.dev
APP_ORIGIN=http://localhost:5173

# Google OAuth Credentials (Phase 1-1: Google OAuth login & calendar sync)
# Already registered in Google Cloud Console OAuth Client.
# Redirect URI registered: http://localhost:5173/api/auth/callback
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Session & Token Encryption Keys (Phase 1-1)
# Keys must be distinct per environment (local/staging/production) and stable across restarts.
#
# SESSION_SECRET: Secret used to sign session cookies.
# - Recommended format: 64 lowercase hex characters generated by:
#     openssl rand -hex 32
#   (256 bits of entropy).
# - Backwards compatibility: Existing runtime accepts any high-entropy string of >= 32 characters.
# - Rotation impact: Rotating SESSION_SECRET invalidates all active sessions (users must sign in again).
SESSION_SECRET=replace-with-openssl-rand-hex-32-value

# TOKEN_ENC_KEY: Encryption key used to encrypt Google refresh tokens at rest (AES-256-GCM).
# - Format: Strict canonical standard Base64 string of exactly 32 bytes (44 characters ending with '=').
#   Generate command:
#     openssl rand -base64 32
# - Rotation impact: Rotating TOKEN_ENC_KEY renders previously encrypted refresh tokens unreadable
#   without a database re-encryption migration or user re-consent.
TOKEN_ENC_KEY=replace-with-openssl-rand-base64-32-value

# Anthropic Claude API (Phase 4-2: Print extraction)
ANTHROPIC_API_KEY=your-anthropic-api-key
# LLM_MODEL=choose-a-supported-model

# Web Push VAPID Keys (Phase 6-5: Web push notifications)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com
